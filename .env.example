# Floci Management Dashboard Configuration

# 1. Backend Floci API Connection (How Next.js server reaches Floci internally)
# Local install / same machine: http://localhost:4566
# Docker compose same network: http://floci:4566
# Remote Tailnet machine: http://100.101.187.9:4566
FLOCI_ENDPOINT=http://localhost:4566

# 2. Initial Network & Access Defaults (Can be configured dynamically from UI at /settings/network)
# Modes: local | lan | tailscale | custom
FLOCI_NETWORK_MODE=local
FLOCI_PUBLIC_HOST=localhost
FLOCI_PUBLIC_PROTOCOL=http
FLOCI_API_PORT=4566

# 3. Settings Lock & Storage Path
# Set to true to lock the network settings in read-only mode for centrally managed deployments
FLOCI_CONFIG_LOCKED=false
FLOCI_CONFIG_STORAGE_PATH=./data/floci-ui-config.json

# 4. Resource Proxy Port Ranges
FLOCI_RDS_PORT_RANGE_START=7001
FLOCI_RDS_PORT_RANGE_END=7099
FLOCI_EC2_SSH_PORT_RANGE_START=2200
FLOCI_EC2_SSH_PORT_RANGE_END=2299
FLOCI_ELASTICACHE_PORT_RANGE_START=6379
FLOCI_ELASTICACHE_PORT_RANGE_END=6399

# 5. AWS Client Credentials for Floci
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1

# 6. Node Environment
NODE_ENV=development
